/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and bookmarks.
 * Tags are publicly readable, but write access is not granted. Snippets have not been defined, so no rules are written for them.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, accessible only to the authenticated user.
 * - /users/{userId}/bookmarks/{snippetSlug}: Stores bookmarks owned by the user.
 * - /tags/{tagId}: Stores publicly accessible tags.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data and bookmarks.
 * - Listing of user profiles is explicitly denied.
 * - Tags are publicly readable to allow snippets to be easily categorized, but write permissions are not granted.
 * - Comments are not defined in the data model, so rules for those are not defined.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by a signed-in user.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the request is made by the owner of the resource.
     * @param {string} userId The user ID to compare with the request's authentication UID.
     * @return {bool} True if the user ID matches the authenticated user's UID, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the request is made by the owner of the resource and the resource exists.
     * @param {string} userId The user ID to compare with the request's authentication UID.
     * @return {bool} True if the user ID matches the authenticated user's UID and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) User 'user_abc' with ID 'user_abc' can create their profile.
     * @deny (create) User 'user_xyz' cannot create profile for 'user_abc'.
     * @allow (get, update, delete) User 'user_abc' can access their profile.
     * @deny (get, update, delete) User 'user_xyz' cannot access profile of 'user_abc'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /users/{userId}/bookmarks/{snippetSlug} collection.
     * @path /users/{userId}/bookmarks/{snippetSlug}
     * @allow (create) User 'user_abc' can create a bookmark.
     * @deny (create) User 'user_xyz' cannot create a bookmark for user 'user_abc'.
     * @allow (get, update, delete) User 'user_abc' can access their bookmarks.
     * @deny (get, update, delete) User 'user_xyz' cannot access bookmarks of 'user_abc'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/bookmarks/{snippetSlug} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

   /**
     * @description Rules for the /tags/{tagId} collection.
     * @path /tags/{tagId}
     * @allow (get, list) Any user can read tags.
     * @deny (create, update, delete) No user can create, update, or delete tags.
     * @principle Tags are publicly readable but not writable.
     */
    match /tags/{tagId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}