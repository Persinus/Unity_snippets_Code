/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and bookmarks.
 * Snippets and Tags are publicly readable, but writes are restricted. Comments are also publicly readable,
 * but writes are open to authenticated users, so long as they populate the author-related fields correctly.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the owning user.
 * - /users/{userId}/bookmarks/{snippetSlug}: Stores bookmarks, accessible only to the owning user.
 * - /tags/{tagId}: Stores tags, publicly readable, writes are not allowed.
 * - /snippets/{snippetId}/comments/{commentId}: Stores comments for snippets, publicly readable, writes are allowed for signed-in users.
 *
 * Key Security Decisions:
 * - User listing is disallowed to protect user privacy.
 * - Tags are read-only for clients, with no write access granted.
 * - Comments are publicly listable and retrievable, reflecting their purpose as a public discussion forum.
 *
 * Denormalization for Authorization:
 *  - Comments require the author's UID to be stored directly on the comment document (Comment.authorId) to enable efficient authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner of the resource.
     * @param {string} userId The user ID to compare against the request's authentication UID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is the owner of the resource and the resource exists.
     * @param {string} userId The user ID to compare against the resource's owner ID.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) User with matching UID can create their profile.
     * @allow (get, update, delete) Only the user with matching UID can access their profile.
     * @deny (create) User cannot create a profile with a different UID.
     * @deny (get, update, delete) User cannot access another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // User listing is not permitted.
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id; // Enforce immutability of user ID.
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for bookmarks.
     * @path /users/{userId}/bookmarks/{snippetSlug}
     * @allow (create) User with matching UID can create bookmarks.
     * @allow (get, update, delete) Only the user with matching UID can access their bookmarks.
     * @deny (create) User cannot create bookmarks with a different UID.
     * @deny (get, update, delete) User cannot access another user's bookmarks.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/bookmarks/{snippetSlug} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for tags. Tags are publicly readable but not writable.
     * @path /tags/{tagId}
     * @allow (get, list) Anyone can read tags.
     * @deny (create, update, delete) No one can create, update, or delete tags via the client.
     * @principle Tags are read-only for clients.
     */
    match /tags/{tagId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Rules for comments on snippets. Comments are publicly readable, but only signed-in users can create them.
     * @path /snippets/{snippetId}/comments/{commentId}
     * @allow (get, list) Anyone can read comments.
     * @allow (create) Signed-in users can create comments if authorId matches their UID.
     * @deny (update, delete) No one can update or delete comments.
     * @principle Comments are publicly readable and creatable by signed-in users with valid author information.
     */
    match /snippets/{snippetId}/comments/{commentId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}