/**
 * @fileoverview Firestore Security Rules for Unity Codex.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for code snippets,
 * where users can only manage snippets they have authored. User profiles
 * are also private and only accessible to the owning user. Tags are
 * publicly readable but only manageable by an admin (currently not
 * implemented, but designed to be easily added in the future).
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, with 'userId' matching the Firebase Authentication UID.
 * - /users/{userId}/snippets/{snippetId}: Stores code snippets created by the user. Each snippet includes an 'authorId' field for authorization.
 * - /tags/{tagId}: Stores publicly available tags that can be associated with code snippets.
 *
 * Key Security Decisions:
 * - Users can only create, read, update, and delete their own user profiles and snippets.
 * - Listing all users is not permitted.
 * - Tags are publicly readable.
 * - Write access to tags is not currently restricted but should be restricted to admins in the future.
 *
 * Denormalization for Authorization:
 * - Snippets contain the 'authorId' field, which is denormalized from the user's document. This allows snippet rules to directly check ownership without requiring additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their own profile with matching ID.
     * @allow (get) User with UID 'user123' can read their own profile.
     * @allow (update) User with UID 'user123' can update their own profile.
     * @allow (delete) User with UID 'user123' can delete their own profile.
     * @deny (create) User with UID 'user456' cannot create a profile for 'user123'.
     * @deny (get) User with UID 'user456' cannot read 'user123' profile.
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not allowed.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to code snippets nested under user profiles.
     * @path /users/{userId}/snippets/{snippetId}
     * @allow (create) User 'user123' can create a snippet under their profile with authorId 'user123'.
     * @allow (get) User 'user123' can read a snippet under their profile.
     * @allow (update) User 'user123' can update a snippet under their profile.
     * @allow (delete) User 'user123' can delete a snippet under their profile.
     * @deny (create) User 'user456' cannot create a snippet for 'user123'.
     * @deny (get) User 'user456' cannot read a snippet under 'user123' profile.
     * @principle Enforces document ownership for all operations on code snippets.
     */
    match /users/{userId}/snippets/{snippetId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(authorId) {
          return request.auth.uid == authorId && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.authorId);
      allow delete: if isExistingOwner(resource.data.authorId);
    }

    /**
     * @description Controls access to tags.
     * @path /tags/{tagId}
     * @allow (get) Any user can read tags.
     * @allow (list) Any user can list tags.
     * @allow (create) Currently open for prototyping; restrict to admins in production.
     * @allow (update) Currently open for prototyping; restrict to admins in production.
     * @allow (delete) Currently open for prototyping; restrict to admins in production.
     * @principle Allows public read access to tags but requires admin privileges for write access in production.
     */
    match /tags/{tagId} {
      allow get: if true;
      allow list: if true;
      allow create: if true; // TODO: Restrict to admins
      allow update: if true; // TODO: Restrict to admins
      allow delete: if true; // TODO: Restrict to admins
    }
  }
}